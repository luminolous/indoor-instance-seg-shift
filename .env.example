# Copy this file to `.env` and fill in the values. `.env` is gitignored; never commit real keys.

# Roboflow API key (only needed to download dataset exports via the API).
ROBOFLOW_API_KEY=

# Weights & Biases (optional). Leave empty and set WANDB_MODE=disabled to log with TensorBoard only.
WANDB_API_KEY=
WANDB_PROJECT=indoor-instance-seg-shift
WANDB_MODE=disabled

# Hugging Face token (optional; public Mask2Former checkpoints do not need it).
HF_TOKEN=
